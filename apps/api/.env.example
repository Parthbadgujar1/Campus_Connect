# CampusConnect API settings. Copy to .env and adjust. Every value below is the built-in default
# for local development, so an empty .env also works. Never commit a real .env.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
LOG_PRETTY=true

# Where the web app runs (links in emails, allowed origins)
WEB_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_URL=http://localhost:4000

# MongoDB. A single-node replica set enables transactions; a standalone server also works.
MONGODB_URL=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB=campus_connect

# Optional: Redis for shared rate limits and realtime across several API processes
REDIS_URL=

# Required in production (leave commented out locally): three different random values of 32+ characters
# (for example: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
# SESSION_SECRET=
# FILE_SIGNING_SECRET=
# IP_HASH_SECRET=
COOKIE_SECURE=false

# Email: "dev" keeps messages in the admin console (Admin → System → Email); "smtp" sends them
MAIL_TRANSPORT=dev
MAIL_FROM=CampusConnect <no-reply@campusconnect.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Uploads: "local" stores files in var/storage; "s3" uses any S3-compatible bucket
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=var/storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=25

# Virus scanning of uploads: "none" or "clamav"
SCANNER=none

# Shown in email footers and legal pages; set the real details before launch
OPERATOR_NAME=CampusConnect (operator name to be confirmed)
OPERATOR_ADDRESS=Registered address to be confirmed, India
SUPPORT_EMAIL=support@campusconnect.local
PRIVACY_EMAIL=privacy@campusconnect.local

JOBS_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
ENABLE_API_DOCS=true

# First college and admin on an empty production database (see ../../RAILWAY.md). Ignored when empty.
# Remove BOOTSTRAP_ADMIN_PASSWORD after the first sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_COLLEGE_NAME=
BOOTSTRAP_COLLEGE_SHORT_NAME=
BOOTSTRAP_COLLEGE_CITY=
BOOTSTRAP_COLLEGE_STATE=

# Production: set to true to start with MAIL_TRANSPORT=dev (emails kept in the admin console).
# The Railway launcher turns this on by itself while SMTP_HOST is empty.
ALLOW_DEV_MAIL=false
