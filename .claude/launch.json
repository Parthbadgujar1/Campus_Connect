{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/api",
        "run",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev:alt"
      ],
      "port": 3001
    },
    {
      "name": "api-test",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/api",
        "run",
        "dev"
      ],
      "env": {
        "MONGODB_DB": "campus_connect_test",
        "PORT": "4100",
        "PUBLIC_API_URL": "http://127.0.0.1:4100",
        "MAIL_TRANSPORT": "dev"
      },
      "port": 4100
    }
  ]
}