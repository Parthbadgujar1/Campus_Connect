{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "CampusConnect API: Fastify + MongoDB, sessions, realtime, email outbox and background jobs",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "start:cluster": "node dist/src/cluster.js",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/under-pressure": "^9.2.1",
    "@fastify/websocket": "^11.3.4",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "file-type": "^22.2.0",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.1.7",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
